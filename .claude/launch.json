{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "waretrack-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "waretrack-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "python", "manage.py", "runserver", "127.0.0.1:8001"],
      "port": 8001
    },
    {
      "name": "waretrack-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
