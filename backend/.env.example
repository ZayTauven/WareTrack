# Copy to .env (never committed) and adjust.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Matches docker-compose.yml at the repository root (PostgreSQL published on 5433).
DATABASE_URL=postgres://waretrack:waretrack@localhost:5433/waretrack
REDIS_URL=redis://localhost:6379/0
# Demo account created by `manage.py seed_demo`.
DEMO_USER_EMAIL=demo@waretrack.test
DEMO_USER_PASSWORD=change-me